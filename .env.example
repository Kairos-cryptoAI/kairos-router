KAIROS_ENVIRONMENT=dev
KAIROS_LOG_LEVEL=INFO
KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://localhost:6379/0
KAIROS_TRADING_SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT"]
KAIROS_CONFLICT_THRESHOLD=4
KAIROS_CALM_THRESHOLD=10
KAIROS_SENTIMENT_DEADBAND=0.25
KAIROS_SENTIMENT_TTL_S=600
KAIROS_SENTIMENT_MIN_CONFIDENCE=0.25
KAIROS_MAX_SENTIMENT_EVIDENCE=5
KAIROS_EVENT_FUTURE_TOLERANCE_S=5
KAIROS_SNAPSHOT_TTL_S=120
KAIROS_TRADING_MODE=DRY_RUN
# PAPER remains REJECT_ALL until a strategy revision passes the offline alpha gate.
KAIROS_PAPER_STRATEGY_ALLOWLIST=[]
KAIROS_CANDIDATE_TTL_S=120
KAIROS_CANDIDATE_REVIEW_TIMEOUT_MS=20000
KAIROS_MAX_CANDIDATE_EVIDENCE_IDS=16
